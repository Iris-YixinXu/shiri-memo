{
  "name": "shiri-cat-chat",
  "main": "index.mjs",
  "compatibility_date": "2026-01-01",
  "workers_dev": true,
  "vars": {
    "WEB_ORIGIN": "https://iris-yixinxu.github.io"
  },
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMIT",
      "namespace_id": "4021",
      "simple": { "limit": 10, "period": 60 }
    }
  ]
}
